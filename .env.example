ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Required only for API keys that are not already scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=
AI_MONTHLY_REQUEST_LIMIT=

# 32 random bytes, base64 (`openssl rand -base64 32`). Encrypts personal data at rest; see docs/security.md.
# Keep a copy: sealed data can't be read without it. Leave empty to store data unencrypted.
DATA_ENCRYPTION_KEY=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_AUTH_ENABLED=false

# Razorpay Plus: keep disabled until test-mode checkout, webhook and cancellation pass.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Charge $10 instead of ₹499 to visitors outside India (needs Razorpay international cards or PayPal active).
RAZORPAY_INTERNATIONAL=false
# Buyers outside India pay through Stripe Checkout when these are set (docs/stripe-setup.md).
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
