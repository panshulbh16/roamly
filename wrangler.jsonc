{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roamly",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  // heyroamly.com is the site; www and the old workers.dev address redirect to it (see worker/index.ts).
  // Keep the old workers.dev address alive: it redirects pages and still serves /api/ (Razorpay webhook).
  "workers_dev": true,
  "routes": [
    { "pattern": "heyroamly.com", "custom_domain": true },
    { "pattern": "www.heyroamly.com", "custom_domain": true }
  ],
  // Production database; CI applies drizzle/ migrations with `wrangler d1 migrations apply`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roamly-db",
      "database_id": "e41c0511-08df-4191-b2b3-6c7840f49bc2",
      "migrations_dir": "drizzle"
    }
  ]
}
